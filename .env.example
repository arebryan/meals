# Copy to .env and fill in. Never commit real secrets.

# App
NODE_ENV=development
AUTH_URL=http://localhost:3000
# Needed for Docker/local host detection. Prefer Auth.js trusted hosts /
# explicit AUTH_URL in production rather than a blanket trust.
AUTH_TRUST_HOST=true
AUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (Auth.js) — required for sign-in
# Create a Web client in Google Cloud Console → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# First admin bootstrap (npm run db:seed)
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Admin

# Postgres (local Docker Compose defaults)
DATABASE_URL=postgres://meal:meal@localhost:5432/meal

# Object storage — fake-gcs-server locally (GCS API stand-in)
STORAGE_ENDPOINT=http://localhost:4443
STORAGE_BUCKET=meal-assets
STORAGE_PUBLIC_HOST=http://localhost:4443
# Optional if you swap back to MinIO/S3 later:
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_REGION=us-east-1

# --- GCP production placeholders (not used locally) ---
# DATABASE_URL=postgres://USER:PASS@/meal?host=/cloudsql/PROJECT:REGION:INSTANCE
# GCS_BUCKET=meal-assets-prod
# GCS_PROJECT_ID=your-gcp-project
# AUTH_URL=https://your-cloud-run-url
# AUTH_SECRET=from-secret-manager
# AUTH_GOOGLE_ID=prod-oauth-client-id
# AUTH_GOOGLE_SECRET=from-secret-manager
